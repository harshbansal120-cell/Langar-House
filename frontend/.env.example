# Supabase handles sign-in. Leave these blank to run the dashboard in demo mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Spring Boot API. Leave empty in development: Vite proxies /api to BACKEND_URL.
# Set it for production builds, e.g. https://langar-house-backend.onrender.com
VITE_API_URL=

# Where the dev proxy sends /api (default http://localhost:8080).
BACKEND_URL=http://localhost:8080

# Force demo mode even when Supabase is configured.
VITE_DEMO_MODE=false
